# Maintainer: NeoBox Team <support@neobox.app>
pkgname=neobox
pkgver=1.8.1
pkgrel=1
pkgdesc="Modern, sleek VPN and Proxy Client powered by sing-box"
arch=('x86_64')
url="https://github.com/Dvarais/NeoBox"
license=('custom')
depends=('webkit2gtk-4.1' 'gtk3')
optdepends=('nftables: Kill Switch support'
            'iptables: Legacy Kill Switch fallback')
install=arch/neobox.install
options=('!debug')
makedepends=('go' 'nodejs' 'npm' 'git')
provides=('neobox')
conflicts=('neobox')

build() {
    # If building inside repo or PKGBUILD directory
    if [ -f "$startdir/../../main.go" ]; then
        cd "$startdir/../.."
    elif [ -f "$startdir/main.go" ]; then
        cd "$startdir"
    fi

    echo "Building NeoBox with WebKit2GTK 4.1..."
    # Wails CLI <= v2.12 bundles x/tools v0.30, which fails on Go 1.25+ with
    # "package ... without types was imported from". Pin a CLI built with newer x/tools.
    go run github.com/wailsapp/wails/v2/cmd/wails@v2.16.0 build -tags "webkit2_41,with_utls,with_clash_api,with_quic,with_wireguard,with_gvisor" -o neobox
}

package() {
    local src_root="$startdir"
    if [ -f "$startdir/../../main.go" ]; then
        src_root="$startdir/../.."
    fi

    install -Dm755 "${src_root}/build/bin/neobox" "${pkgdir}/usr/bin/neobox"
    install -Dm644 "${src_root}/build/linux/neobox.desktop" "${pkgdir}/usr/share/applications/neobox.desktop"
    install -Dm644 "${src_root}/build/linux/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/neobox.png"
}
