# Executables and Installer Binaries (Avoid pushing large files to GitHub)
*.exe
*.exe~
NeoBox-Go.exe
NeoBox_Setup_v*.exe

# Linux package releases and standalone archives (stored in GitHub Releases, not git tree)
*.deb
*.pkg.tar.zst
*.tar.gz
*.tar.xz
build/bin/
build/windows/installer/tmp/

# Frontend Build Output
frontend/dist/*
!frontend/dist/.gitkeep

# System and temporary runtime leftovers
/icon.ico
*.log
*.tmp
*.db
dev/null
null

# Dependency Directories
node_modules/
frontend/node_modules/

# User, Temporary and Agent-Specific Data
test_user_data/
.antigravitycli/
.claude/
.DS_Store
Thumbs.db

# Internal Documentation, Specifications and Development Tools
Баги и изменения.txt
BUGS.md
PRODUCT.md
DESIGN.md
.impeccable/
dev/

# Go Build and Test Artifacts
*.test
*.out

# Cryptographic Keys and Signatures (Never commit secrets or temporary release signatures)
*.sig
*.key
*.pem
private_key*

# Superpowers, IDEs, and GitHub Workflows
docs/superpowers/
.github/workflows/
.vscode/
.idea/

# makepkg output from building build/linux/PKGBUILD in place
build/linux/src/
build/linux/pkg/
build/linux/*.pkg.tar.zst
